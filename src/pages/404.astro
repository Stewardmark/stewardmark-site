---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

// Served by Cloudflare Pages with a real 404 status for any URL that does not
// exist. Without this file, Pages treats the site as a single-page app and
// answers unknown URLs with the homepage and a 200, which search engines read
// as duplicate content.
---

<Base
  title="Page not found | Stewardmark"
  description="This page does not exist.  Use the links here to find Stewardmark's services, articles, and contact details."
>
  <section class="hero band">
    <div class="container hero__inner">
      <div class="hero__eyebrow">404</div>
      <h1 class="hero__headline">This page does not exist.</h1>
      <p class="hero__subhead">
        The link may be old or mistyped.  These pages will get you where you are going.
      </p>
      <ul class="notfound__links">
        <li><a href="/">Home</a></li>
        <li><a href="/#services">Services</a></li>
        <li><a href="/articles">Articles</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </section>

  <Footer variant="home" />
</Base>

<style>
  .hero__inner {
    padding: clamp(48px, 8vw, 96px) var(--container-pad-x) clamp(40px, 6vw, 72px);
  }
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 20px;
  }
  .hero__headline {
    font-size: clamp(34px, 5.5vw, 56px);
    font-weight: 300;
    letter-spacing: var(--tracking-display);
    line-height: 1.12;
    color: var(--color-white);
    max-width: 20ch;
    text-wrap: pretty;
  }
  .hero__subhead {
    font-size: clamp(16px, 2.2vw, 19px);
    max-width: 52ch;
    margin-top: 26px;
    color: var(--color-mist);
  }
  .notfound__links {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }
  .notfound__links a {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-accent);
  }
  .notfound__links a:hover {
    color: var(--color-white);
  }
</style>
